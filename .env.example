# Required for real Emissary API calls.
EMISSARY_API_KEY=replace_me

# Required for live Emissary Projects fine-tuning unless passed on the CLI.
# EMISSARY_PROJECT_ID=ms-example

# Required for real OpenAI API calls.
OPENAI_API_KEY=replace_me

# GPT-6 Decisions: zero-shot choice classification, independent of GPT-5 baseline.
# OPENAI_DECISIONS_MODEL=gpt-6-luna
# OPENAI_DECISIONS_TIMEOUT_S=120
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=org-example
# OPENAI_PROJECT_ID=proj_example

# Recommended for Hugging Face Hub downloads. Public datasets/models may work
# without it, but authenticated requests have higher rate limits.
HF_TOKEN=hf_replace_me
JEV_TOKEN=jev_token

# Optional: reuse an existing Emissary experiment/version in integration tests.
# Expected format: <experiment_id>/<version>
# EMISSARY_TEST_MODEL_ID=ex-example/0.0.0
